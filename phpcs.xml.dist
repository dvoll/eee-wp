<?xml version="1.0"?>
<ruleset name="EEE-WP Coding Standards">
    <description>WordPress Coding Standards tailored for EEE WordPress project.</description>

    <!-- Scan themes and plugins -->
    <file>themes/eee-theme</file>
    <file>plugins</file>

    <!-- Exclude third-party and build directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>
    <exclude-pattern>*.asset.php</exclude-pattern>

    <!-- Pass arguments -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- Ignore warnings on exit (exit with 0 if only warnings are found) -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Set minimum supported WordPress version -->
    <config name="minimum_supported_wp_version" value="6.4"/>

    <!-- Set PHP test version range (PHP 8.1+) -->
    <config name="testVersion" value="8.1-"/>

    <!-- Include PHPCompatibilityWP for PHP and WordPress compatibility checking -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Include WordPress-Extra (Security, Best Practices, Escaping, Nonces) -->
    <rule ref="WordPress-Extra">
        <!-- Exclude tab/space and indentation enforcement to respect existing project formatting -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
        <exclude name="Universal.WhiteSpace.DisallowInlineTabs"/>

        <!-- Allow modern short array syntax [] -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

        <!-- Allow flexible function spacing, control structure spacing, and quotation style -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="PSR2.Methods.FunctionClosingBrace"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="Squiz.Strings.ConcatenationSpacing"/>
        <exclude name="Squiz.Strings.DoubleQuoteUsage"/>
        <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace"/>
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
        <exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
        <exclude name="WordPress.WhiteSpace.CastStructureSpacing"/>
    </rule>

    <!-- Verify text domain consistency where applicable -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="eee-theme"/>
                <element value="eee23-theme"/>
                <element value="eee23-blocks"/>
                <element value="eee23-mail-config"/>
            </property>
        </properties>
    </rule>
</ruleset>
